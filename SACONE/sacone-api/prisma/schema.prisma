generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local default: SQLite. Point DATABASE_URL at PostgreSQL when master DB is running.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("STAFF")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id          String         @id @default(cuid())
  name        String
  email       String?
  phone       String         @unique
  company     String?
  address     String?
  gstNumber   String?
  gstVerified Boolean        @default(false)
  notes       String?
  source      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      Order[]
  quotes      QuoteRequest[]
}

model Product {
  id                String          @id
  erpItemId         String?
  storeBrand        String          @default("sacvolt") // main public store: sacvolt
  name              String
  brand             String
  category          String
  price             Int
  mrp               Int?
  sku               String          @unique
  availability      String
  stockCount        Int
  lowStockThreshold Int             @default(10)
  image             String
  images            String
  description       String
  specifications    String
  rating            Float
  reviewCount       Int
  featured          Boolean         @default(false)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  quoteItems        QuoteItem[]
  stockMovements    StockMovement[]
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  customerName  String
  phone         String
  address       String
  city          String?
  state         String?
  pincode       String?
  gstNumber     String?
  paymentMethod String      @default("cod")
  subtotal      Int
  gstAmount     Int
  total         Int
  status        String      @default("pending")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  invoice       Invoice?
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Int
  totalPrice Int
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model QuoteRequest {
  id               String      @id @default(cuid())
  quoteNumber      String      @unique
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id])
  customerName     String
  email            String
  phone            String
  company          String?
  address          String?
  message          String?
  status           String      @default("pending")
  validityDate     DateTime
  subtotal         Int
  gstNote          String      @default("GST @ 18% applicable as per government norms. Prices are exclusive of GST unless stated otherwise.")
  adminNotes       String?
  convertedOrderId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            QuoteItem[]
}

model QuoteItem {
  id         String       @id @default(cuid())
  quoteId    String
  quote      QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Int
  totalPrice Int
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        String
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reason      String?
  referenceId String?
  createdBy   String?
  createdAt   DateTime @default(now())
}

/// Control Center — single settings store for ERP + Web Store + domain
model PlatformSettings {
  id                  String   @id @default("singleton")
  companyName         String   @default("SACONE")
  companyTagline      String   @default("Unified Business Control Center")
  companyAddress      String   @default("")
  companyPhone        String   @default("")
  companyEmail        String   @default("")
  companyGstin        String   @default("")
  companyWebsite      String   @default("")
  adminAllowedHosts   String   @default("localhost:3000,127.0.0.1:3000")
  erpUrl              String   @default("/erp")
  ceoDashboardUrl     String   @default("")
  ceoEnabled          Boolean  @default(false)
  webstoreEnabled     Boolean  @default(true)
  saconeStoreEnabled  Boolean  @default(false)
  sacvoltStoreEnabled Boolean  @default(true)
  saconeStorefrontUrl String   @default("")
  sacvoltStorefrontUrl String  @default("http://localhost:3001")
  currency            String   @default("INR")
  currencySymbol      String   @default("₹")
  timezone            String   @default("Asia/Kolkata")
  dateFormat          String   @default("dd/MM/yyyy")
  lowStockThreshold   Int      @default(10)
  deadStockDays       Int      @default(60)
  pinLockMinutes      Int      @default(10)
  syncApiKey           String   @default("")
  syncEnabled          Boolean  @default(false)
  syncRegisteredEmail  String   @default("")
  lastSyncAt           String   @default("")
  erpLinkApiKey        String   @default("")
  erpInventoryLinked   Boolean  @default(false)
  erpLastProductSyncAt String   @default("")
  updatedAt            DateTime @updatedAt
}

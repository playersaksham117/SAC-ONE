    "express": "^5.2.1",
    "jose": "^6.2.3",
    "multer": "^1.4.5-lts.2",
    "next": "^15.3.3",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.0",
    "pg-mem": "^3.0.14",
    "prisma": "6.19.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",

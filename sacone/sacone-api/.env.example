PORT=4000
NODE_ENV=development
# Logical environment: development | staging | production
# Destructive db:reset / mongo:reset only allowed when APP_ENV=development
APP_ENV=development

# local = this PC is the server: SQLite + local domain + LAN clients (default)
SERVER_MODE=local
# Served by the gateway (npm run gateway): http://erp.sacone.local, owner., api.
LOCAL_DOMAIN=sacone.local

DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/sacone.db
EXPORT_DIR=./data/exports

# ── Cloud link (docs/CLOUD_LINK.md) ── leave empty while working as a local server.
# `npm run cloud:export` copies everything to these targets and verifies it; the app
# keeps running on SQLite (DATABASE_DRIVER=sqlite) until you cut over.
# MongoDB Atlas OR local Mongo: business data
# Example Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Example local:
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DATABASE=sacone
MONGODB_MAX_POOL_SIZE=10
# Safety gate: must be true to allow Mongo import/reset writes
MONGODB_WRITE_ENABLED=false

# Supabase: authentication + RBAC (Project Settings → API / Database)
SUPABASE_URL=
# service_role (or sb_secret_…) key: server only, never put it in a frontend
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string (Connect → Session pooler)
SUPABASE_DB_URL=

SESSION_TTL_HOURS=24
# Optional — reserved for future JWT auth (sessions are primary today)
JWT_SECRET=

# Comma-separated browser origins for the ERP UI (native POS/mobile apps send no Origin)
CORS_ORIGIN=http://localhost:3000
# SACONE Owner app (CEO Dashboard, Income & Expense). Always allowed; add LAN URLs here if needed.
OWNER_APP_ORIGIN=http://localhost:3001
# 0.0.0.0 = reachable from POS terminals / phones on the LAN
HOST=0.0.0.0
JSON_BODY_LIMIT=5mb

# POS device sync (BillEase POS ↔ SACONE) — see docs/POS_SYNC_API.md
POS_SYNC_TOTAL_TOLERANCE=1
POS_DEFAULT_TZ_OFFSET=+05:30
DEFAULT_ADMIN_EMAIL=admin@sacone.local
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=System Administrator
# Set to true only for local demos (sample products, parties, demo API key)
SEED_DEMO_DATA=false
